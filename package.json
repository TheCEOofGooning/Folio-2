{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "description": "Folio — a lightning-fast, dependency-light publishing platform for everyone.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
