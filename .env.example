# ─────────────────────────────────────────────────────────────────────────────
# Folio — environment variables
#
# Local development:  copy to `.env.local` (or just run `npm run dev:db`, which
# points at the bundled PGlite sidecar below).
# Production (Vercel): add each of these in Project → Settings → Environment
# Variables. See README → "Deploy to Vercel + Neon".
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Neon pooled connection string, e.g.
# postgresql://folio_owner:••••@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/folio?sslmode=require
# Use the "-pooler" host: it talks to Neon's PgBouncer so serverless functions
# never exhaust Postgres connections.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/folio"

# Optional override. Folio derives the SQL-over-HTTP endpoint from DATABASE_URL by
# swapping the first hostname label for `api.` — i.e.
# ep-x-pooler.us-east-2.aws.neon.tech -> https://api.us-east-2.aws.neon.tech/sql
# (the same transform @neondatabase/serverless uses). You only need this override
# for a Neon-compatible gateway that routes /sql on the database host instead.
# DATABASE_HTTP_ENDPOINT=""

# REQUIRED in production — 32+ random bytes used to HMAC-sign session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FOLIO_SESSION_SECRET="dev-only-secret-change-me-0000000000000000000000"

# Public site URL, used for canonical links, OG tags, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — demo seeding + local sidecar port
# FOLIO_DB_PORT=5433
