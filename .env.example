# ---------------------------------------------------------------------------
# Folio environment
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon serverless Postgres.
# Neon dashboard → your project → Connection Details → "Pooled connection"
# string, then append `-pooler` to the host as shown in the dashboard.
#
# Leave this UNSET to run against the built-in in-memory engine, which loads
# demo content and needs no infrastructure at all.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies (HMAC-SHA256). REQUIRED in production — the app throws
# at boot without it. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-32-plus-random-characters"

# Used for metadata/OG absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
